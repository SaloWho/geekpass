<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Must match UmbracoAppLocalIcuVersion in GeekPass.Web.csproj (same value as the Umbraco 18.3.1 project template). -->
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Version choice is recorded in README.md ("Versions") and ADR-0004. -->
    <PackageVersion Include="Umbraco.Cms" Version="18.3.1" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>
</Project>
