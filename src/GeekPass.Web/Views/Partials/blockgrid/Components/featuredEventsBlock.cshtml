@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@{
    var maxItems = Math.Clamp(Model.Content.Value<int>(ContentModel.Properties.MaxItems), 1, 6);

    // The block lives on Home; the events live under Programme.
    IPublishedContent? page = UmbracoContext?.PublishedRequest?.PublishedContent;
    var events = page?.Root().Children()
        .Where(x => x.ContentType.Alias == ContentModel.Aliases.Programme)
        .SelectMany(programme => programme.Children())
        .Where(x => x.ContentType.Alias == ContentModel.Aliases.FestivalEvent)
        .Where(x => x.Value<DateTime>(ContentModel.Properties.StartsAt) >= DateTime.Now)
        .OrderBy(x => x.Value<DateTime>(ContentModel.Properties.StartsAt))
        .Take(maxItems)
        .ToList() ?? [];
}
<section class="featured-events">
    <h2>@(Model.Content.Value<string>(ContentModel.Properties.Heading))</h2>
    @if (events.Count == 0)
    {
        <p class="muted">No upcoming events are published yet.</p>
    }
    else
    {
        <ul class="card-list">
            @foreach (IPublishedContent item in events)
            {
                <li class="card">
                    <time>@(item.Value<DateTime>(ContentModel.Properties.StartsAt).ToString("ddd d MMM, HH:mm"))</time>
                    <h3><a href="@item.Url()">@item.Name</a></h3>
                    <p>@(item.Value<string>(ContentModel.Properties.Summary))</p>
                </li>
            }
        </ul>
    }
</section>
