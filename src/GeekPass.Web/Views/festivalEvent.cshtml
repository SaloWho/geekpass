@inherits UmbracoViewPage
@inject ProgrammeReader ProgrammeReader
@inject FestivalClock Clock
@{
    Layout = "~/Views/_Layout.cshtml";
    ProgrammeEvent item = ProgrammeReader.Map(Model);
    bool bookable = Model.Value<bool>(ContentModel.Properties.Bookable);
}
<article class="event" data-event-key="@item.Key">
    <p class="eyebrow">
        @if (!string.IsNullOrEmpty(item.Track))
        {
            <span class="track-badge" data-track="@item.Track">@item.Track</span>
        }
        <time datetime="@item.StartsAt.ToString("O")">@item.StartsAt.ToString("dddd d MMMM yyyy · HH:mm")</time>–@item.EndsAt.ToString("HH:mm")
        <span class="muted">(@Clock.OffsetLabel(item.StartsAt))</span>
    </p>
    <h1>@item.Name</h1>
    <p class="subtitle">@(Model.Value<string>(ContentModel.Properties.Subtitle))</p>
    <p class="lead">@item.Summary</p>
    <p><strong>Venue:</strong> @item.Venue</p>

    <div class="rich-text">
        @(Model.Value<IHtmlEncodedString>(ContentModel.Properties.Description))
    </div>

    @if (bookable)
    {
        @* Stage 2 replaces this placeholder with live availability from the Booking module. *@
        <aside class="booking-placeholder">
            <strong>Booking opens soon.</strong>
            <span>@(Model.Value<int>(ContentModel.Properties.RequestedCapacity)) seats planned.</span>
        </aside>
    }
</article>
